#include "../tiny18/tiny18.dtsi"

&default_transform {
    columns = <9>;
    col-offset = <0>;
    map = <RC(0,7) RC(0,8) RC(0,0) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,2) RC(0,1)>;
};

&tiny18_physical_layout {
    display-name = "Standalone L";
    keys = <&key_physical_attrs 100 100  100    0       0     0     0>,
           <&key_physical_attrs 100 100  200    0       0     0     0>,
           <&key_physical_attrs 100 100  300    0       0     0     0>,
           <&key_physical_attrs 100 100    0  150       0     0     0>,
           <&key_physical_attrs 100 100  100  100       0     0     0>,
           <&key_physical_attrs 100 100  200  100       0     0     0>,
           <&key_physical_attrs 100 100  300  100       0     0     0>,
           <&key_physical_attrs 100 100  250  200       0     0     0>,
           <&key_physical_attrs 100 100  350  200       0     0     0>;
};

&xiao_serial { status = "disabled"; };
