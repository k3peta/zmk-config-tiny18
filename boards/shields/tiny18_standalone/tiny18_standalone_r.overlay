#include "../tiny18/tiny18.dtsi"

&default_transform {
    columns = <9>;
    col-offset = <0>;
    map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,8) RC(0,7)>;
};

&tiny18_physical_layout {
    display-name = "Standalone R";
    keys = <&key_physical_attrs 100 100  700    0       0     0     0>,
           <&key_physical_attrs 100 100  800    0       0     0     0>,
           <&key_physical_attrs 100 100  900    0       0     0     0>,
           <&key_physical_attrs 100 100  700  100       0     0     0>,
           <&key_physical_attrs 100 100  800  100       0     0     0>,
           <&key_physical_attrs 100 100  900  100       0     0     0>,
           <&key_physical_attrs 100 100 1000  150       0     0     0>,
           <&key_physical_attrs 100 100  550  200       0     0     0>,
           <&key_physical_attrs 100 100  650  200       0     0     0>;
};

&xiao_serial { status = "disabled"; };
